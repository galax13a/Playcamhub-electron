{
  "name": "playcamhub-studio",
  "productName": "PlaycamHub Studio",
  "version": "1.0.4",
  "description": "Music player with Spotify UI and TikTok experience — download, organize, and vibe.",
  "main": "main.js",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "check-node": "node scripts/check-node.js",
    "start": "node scripts/check-node.js && electron .",
    "dev": "node scripts/check-node.js && cross-env NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.playcamhub.studio",
    "productName": "PlaycamHub Studio",
    "copyright": "Copyright © 2024 PlaycamHub Studio",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/yt-dlp-wrap/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "plugins/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!dist/**/*",
      "!*.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.png",
      "publisherName": "PlaycamHub Studio"
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "icon": "assets/icons/icon.icns",
      "category": "public.app-category.music",
      "darkModeSupport": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons/icon.png",
      "category": "Audio"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PlaycamHub Studio"
    },
    "dmg": {
      "title": "PlaycamHub Studio Installer",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "publish": {
      "provider": "github",
      "owner": "galax13a",
      "repo": "PlaycamHub-Studio",
      "releaseType": "release"
    }
  },
  "keywords": [
    "music",
    "player",
    "youtube",
    "spotify",
    "tiktok",
    "electron"
  ],
  "author": {
    "name": "PlaycamHub Dev",
    "email": "botcamdev@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "cross-env": "^7.0.3",
    "electron": "^42.3.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "@types/node": "^22.8.0",
    "@types/better-sqlite3": "^7.6.11",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.5",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^2.1.1",
    "node-id3": "^0.2.6",