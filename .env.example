# ═══════════════════════════════════════════════════════════════════
#  StarchoElectron — Environment Variables
#  Requires Node.js >= 22 and Express.
#  Copy this file to .env and edit the values you need.
#  All variables have safe defaults; no changes are required to run.
# ═══════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────
# Express API port. Auto-increments if the port is already in use.
PORT=3026

# ── App identity ────────────────────────────────────────────────────
# Windows taskbar App User Model ID (groups related windows together)
APP_ID=com.starcho.electron

# ── Branding (shown in UI) ───────────────────────────────────────────
APP_NAME=StarchoElectron
APP_VERSION=1.0.0
APP_TITLE=StarchoElectron — Music Player
APP_SLOGAN=Gestor de Música para creadores
LOGO_TEXT=App Music

# ── Developer tools ──────────────────────────────────────────────────
# DEVTOOLS=true  → abre DevTools al iniciar (SOLO en modo desarrollo, nunca en producción)
# F12            → toggle DevTools (SOLO disponible en modo desarrollo)
# En producción (app empaquetada con electron-builder) DevTools está COMPLETAMENTE
# deshabilitado sin importar el valor de esta variable.
DEVTOOLS=false

# ── Modo de producción ───────────────────────────────────────────────
# IS_PROD se detecta automáticamente:
#   - true  si la app fue empaquetada con electron-builder (app.isPackaged)
#   - true  si NODE_ENV=production
#   - false en cualquier otro caso (npm run dev, npm start)
#
# En producción se aplican automáticamente:
#   - DevTools completamente deshabilitado (devTools: false en BrowserWindow)
#   - Sandbox habilitado en los procesos renderer
#   - remote-debugging-port=0 (sin acceso remoto al DevTools protocol)
#   - Bloqueo de navegación a URLs externas (will-navigate, will-redirect)
#   - Bloqueo de apertura de nuevas ventanas desde el renderer
#   - Denegación de errores de certificado
#   - Log level: warn (sin logs de info/debug en producción)
#   - Auto-updater habilitado
#NODE_ENV=production
